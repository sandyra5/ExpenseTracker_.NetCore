@using System.Data
@{
    Layout = null;
    string type = ViewBag.Type;
    DataTable categories = ViewBag.Categories;
}

<!DOCTYPE html>
<html>
<head>
    <title>Add @type - Expense Tracker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f5f8f5;
            font-family: Arial, sans-serif;
        }

        .form-card {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .btn-save {
            background: #198754;
            color: white;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="form-card">
            <h2 class="mb-2">Add @type</h2>
            <p class="text-muted mb-4">Enter your transaction details.</p>
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Message
                </div>
            }
            <form method="post" asp-controller="Transaction"
                  asp-action="TransactionSave">

                <input type="hidden" name="TransactionType" value="@type" />

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="CategoryId" class="form-select" required>
                        <option value="">Select category</option>
                        @foreach (DataRow row in categories.Rows)
                        {
                            <option value="@row["CategoryId"]">
                                @row["CategoryName"]
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Amount (₹)</label>
                    <input type="number" name="Amount" class="form-control"
                           min="0.01" step="0.01" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Date</label>
                    <input type="date" name="TransDate" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Description (optional)</label>
                    <textarea name="Description" class="form-control"
                              rows="3" maxlength="350"></textarea>
                </div>

                <button type="submit" class="btn btn-save w-100 py-2">
                    Save @type
                </button>

                <a asp-controller="Dashboard" asp-action="DashLoad"
                   class="btn btn-outline-secondary w-100 mt-2">
                    Back to Dashboard
                </a>
            </form>
        </div>
    </div>

</body>
</html>
