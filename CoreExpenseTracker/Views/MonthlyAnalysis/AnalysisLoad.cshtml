@model CoreExpenseTracker.Models.MonthlyAnalysisModel

@{
    Layout = null;
    ViewData["Title"] = "Monthly AI Analysis";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Monthly AI Analysis</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f8f5;
            font-family: Arial, sans-serif;
            color: #26382c;
        }

        .navbar {
            background: #245c42;
        }

        .main-container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 16px;
        }

        .analysis-card {
            background: white;
            border-radius: 16px;
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .summary-card {
            border-left: 5px solid #f0a44b;
        }

        .amount {
            font-size: 24px;
            font-weight: bold;
        }

        .income {
            color: #198754;
        }

        .expense {
            color: #dc654f;
        }

        .balance {
            color: #245c42;
        }

        .btn-green {
            background: #245c42;
            color: white;
        }

            .btn-green:hover {
                background: #19452f;
                color: white;
            }

        .category-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eeeeee;
        }

        .ai-text {
            white-space: pre-wrap;
            line-height: 1.8;
        }

            .ai-text h1,
            .ai-text h2,
            .ai-text h3 {
                color: #245c42;
                margin-top: 20px;
                margin-bottom: 12px;
            }

            .ai-text table {
                width: 100%;
                border-collapse: collapse;
                margin: 16px 0;
            }

            .ai-text th,
            .ai-text td {
                padding: 10px;
                border: 1px solid #dee5df;
                text-align: left;
            }

            .ai-text th {
                background: #eaf3ec;
            }

            .ai-text ul,
            .ai-text ol {
                padding-left: 24px;
                margin-bottom: 16px;
            }

            .ai-text li {
                margin-bottom: 8px;
            }

            .ai-text strong {
                color: #245c42;

            }

        /* Compact AI report spacing */
        .ai-text {
            white-space: normal;
            line-height: 1.5;
            font-size: 15px;
        }

            .ai-text h1,
            .ai-text h2,
            .ai-text h3,
            .ai-text h4 {
                margin-top: 14px;
                margin-bottom: 6px;
            }

            .ai-text p {
                margin-top: 0;
                margin-bottom: 8px;
            }

            .ai-text ul,
            .ai-text ol {
                margin-top: 4px;
                margin-bottom: 10px;
                padding-left: 24px;
            }

            .ai-text li {
                margin-bottom: 4px;
                padding-left: 2px;
            }

            .ai-text table {
                margin: 8px 0 12px;
            }

            .ai-text th,
            .ai-text td {
                padding: 6px 10px;
            }

    </style>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>

</head>

<body>

    <nav class="navbar navbar-dark px-4 py-3">
        <a class="navbar-brand fw-bold" href="/Dashboard/DashLoad">
            Expense Tracker
        </a>

        <a href="/Dashboard/DashLoad"
           class="btn btn-outline-light btn-sm">
            Back to Dashboard
        </a>
    </nav>

    <div class="main-container">

        <h2 class="fw-bold mb-2">Monthly AI Analysis 🤖</h2>
        <p class="text-muted mb-4">
            Understand your spending habits with your personal AI assistant.
        </p>

        <!-- Month selection -->
        <div class="analysis-card">
            <form method="get"
                  action="/MonthlyAnalysis/AnalysisLoad">

                <label for="month" class="form-label fw-bold">
                    Select month
                </label>

                <div class="d-flex gap-2 flex-wrap">
                    <input type="month"
                           id="month"
                           name="month"
                           value="@Model.Month"
                           class="form-control"
                           style="max-width: 250px;"
                           required />

                    <button type="submit" class="btn btn-green">
                        View Analysis
                    </button>
                </div>
            </form>
        </div>


        <!-- Generate AI summary -->
        <div class="analysis-card summary-card">
            <h5 class="fw-bold mb-2">✨ Your AI Financial Insights</h5>

            <p class="text-muted">
                Get a personalized summary and practical spending suggestions.
            </p>

            <form method="post"
                  action="/MonthlyAnalysis/GenerateSummary">

                <input type="hidden"
                       name="month"
                       value="@Model.Month" />

                <button type="submit" class="btn btn-green mb-3">
                    Generate AI Summary
                </button>
            </form>


            @if (!string.IsNullOrWhiteSpace(Model.AISummary))
            {
                <hr />
                <div id="aiSummary" class="ai-text"></div>

                <script>
                    const aiMarkdown = @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(Model.AISummary)
                                    );

                const renderedHtml = marked.parse(aiMarkdown);

                    document.getElementById("aiSummary").innerHTML =
                        DOMPurify.sanitize(renderedHtml);
                </script>
                        }

        </div>

    </div>

</body>
</html>
