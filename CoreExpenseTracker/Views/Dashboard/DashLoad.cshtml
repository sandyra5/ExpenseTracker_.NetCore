@using System.Data
@using System.Linq
@model CoreExpenseTracker.Models.DashboardModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Expense Tracker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f5f8f5;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #198754;
            color: white;
            padding: 18px 30px;
        }

        .dashboard {
            padding: 30px;
        }

        .summary-card {
            background-color: white;
            padding: 24px;
            border-radius: 15px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
            height: 100%;
        }

            .summary-card h6 {
                color: #777;
                margin-bottom: 12px;
            }

            .summary-card h3 {
                font-weight: bold;
            }

        .income {
            border-left: 5px solid #198754;
        }

        .balance {
            border-left: 5px solid #0d6efd;
        }

        .today {
            border-left: 5px solid #fd7e14;
        }

        .monthly {
            border-left: 5px solid #6f42c1;
        }

        .section-card {
            background-color: white;
            padding: 24px;
            border-radius: 15px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        .btn-income {
            background-color: #198754;
            color: white;
        }

        .btn-expense {
            background-color: #fd7e14;
            color: white;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>


    <nav class="navbar d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Expense Tracker</h4>

        <div class="d-flex gap-2">
            <a asp-controller="Profile" asp-action="ProfileLoad"
               class="btn btn-light">
                My Profile
            </a>
            <a href="/MonthlyAnalysis/AnalysisLoad"
               class="btn btn-light">
                AI Monthly Analysis ✨
            </a>
            <a asp-controller="Login" asp-action="Logout"
               class="btn btn-outline-light">
                Logout
            </a>
          
        </div>
    </nav>



    <div class="container-fluid dashboard">

        <h2 class="mb-2">Dashboard</h2>
        <p class="text-muted mb-4">Here's your financial overview.</p>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">
                <div class="summary-card income">
                    <h6>Monthly Income</h6>
                    <h3 class="text-success">₹@Model.MonthlyIncome.ToString("N2")</h3>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="summary-card balance">
                    <h6>Monthly Balance</h6>
                    <h3 class="text-primary">₹@Model.MonthlyBalance.ToString("N2")</h3>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="summary-card today">
                    <h6>Today's Expenses</h6>
                    <h3 style="color:#fd7e14;">₹@Model.TodayExpenses.ToString("N2")</h3>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="summary-card monthly">
                    <h6>Monthly Expenses</h6>
                    <h3 style="color:#6f42c1;">₹@Model.MonthlyExpenses.ToString("N2")</h3>
                </div>
            </div>

        </div>

        <div class="d-flex flex-wrap gap-3 mt-4 mb-4">
            <a href="/Transaction/TransactionLoad?type=Income"
               class="btn btn-income px-4 py-2">+ Add Income</a>

            <a href="/Transaction/TransactionLoad?type=Expense"
               class="btn btn-expense px-4 py-2">+ Add Expense</a>
        </div>


        <div class="row g-4 mt-1">

            <!-- Monthly Expense Chart -->
            <div class="col-lg-6">
                <div class="section-card h-100">
                    <h5 class="mb-3">Monthly Expense Breakdown</h5>

                    <div style="height: 280px; position: relative;">
                        <canvas id="expenseChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="col-lg-6">
                <div class="section-card h-100">
                    <h5 class="mb-3">Recent Transactions</h5>

                    @{
                        System.Data.DataTable recent = ViewBag.RecentTransactions;
                    }

                    @if (recent.Rows.Count == 0)
                    {
                        <p class="text-muted">No transactions yet.</p>
                    }
                    else
                    {
                        foreach (System.Data.DataRow row in recent.Rows)
                        {
                            bool isIncome =
                            row["TransactionType"].ToString() == "Income";

                            <div class="d-flex justify-content-between align-items-center gap-3 border-bottom py-3">
                                <div class="flex-grow-1">
                                    <strong>@row["CategoryName"]</strong>

                                    <div class="text-muted small">
                                        @Convert.ToDateTime(row["TransDate"]).ToString("dd MMM yyyy")
                                    </div>

                                    @if (row["Description"] != DBNull.Value &&
                                                                !string.IsNullOrWhiteSpace(row["Description"].ToString()))
                                    {
                                        <div class="text-muted small">
                                            @row["Description"]
                                        </div>
                                    }
                                </div>

                                <strong class="text-nowrap @(isIncome ? "text-success" : "text-danger")">
                                    @(isIncome ? "+" : "−")₹@Convert.ToDecimal(row["Amount"]).ToString("N2")
                                </strong>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>


    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const categoryLabels = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ((System.Data.DataTable)ViewBag.ExpenseCategories)
                                .AsEnumerable()
                                .Select(row => row["CategoryName"].ToString())
                        )
                );

        const categoryAmounts = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ((System.Data.DataTable)ViewBag.ExpenseCategories)
                                .AsEnumerable()
                                .Select(row => Convert.ToDecimal(row["TotalAmount"]))
                        )
                );

        const ctx = document.getElementById('expenseChart');

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryAmounts
                }]
            },
                    options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
        });
    </script>
</body>
</html>


