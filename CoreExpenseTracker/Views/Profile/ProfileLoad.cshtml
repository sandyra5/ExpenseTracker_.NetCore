@model CoreExpenseTracker.Models.UserProfile

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f4f8f5;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #198754;
        }

        .profile-card {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        }

        .profile-photo {
            width: 110px;
            height: 110px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #198754;
        }

        .btn-edit {
            background: #fd7e14;
            color: white;
        }

            .btn-edit:hover {
                background: #e96b02;
                color: white;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-dark px-4 py-3">
        <span class="navbar-brand fw-bold">Expense Tracker</span>
        <a href="/Dashboard/DashLoad" class="btn btn-light btn-sm">
            Back to Dashboard
        </a>
    </nav>

    <div class="container">
        <div class="profile-card">

            <h3 class="text-center mb-4">My Profile</h3>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">@ViewBag.Message</div>
            }

            <form asp-controller="Profile"
                  asp-action="ProfileUpdate"
                  method="post">

                <div class="text-center mb-4">
                    <img src="@Model.Photo"
                         alt="Profile Photo"
                         class="profile-photo" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control"
                           value="@Model.Name"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control"
                           value="@Model.Email"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input class="form-control"
                           value="@Model.Username"
                           readonly />
                </div>

                <div class="mb-4">
                    <label class="form-label">Profession</label>
                    <input type="text"
                           id="profession"
                           name="Profession"
                           class="form-control"
                           value="@Model.Profession"
                           readonly
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            id="editBtn"
                            class="btn btn-edit w-100"
                            onclick="enableEdit()">
                        Edit
                    </button>

                    <button type="submit"
                            id="saveBtn"
                            class="btn btn-success w-100"
                            style="display:none;">
                        Save Changes
                    </button>

                    <button type="button"
                            id="cancelBtn"
                            class="btn btn-secondary w-100"
                            style="display:none;"
                            onclick="cancelEdit()">
                        Cancel
                    </button>
                </div>

            </form>
        </div>
    </div>

    <script>
        let originalProfession = "";

        function enableEdit() {
            let profession = document.getElementById("profession");

            originalProfession = profession.value;
            profession.readOnly = false;
            profession.focus();

            document.getElementById("editBtn").style.display = "none";
            document.getElementById("saveBtn").style.display = "block";
            document.getElementById("cancelBtn").style.display = "block";
        }

        function cancelEdit() {
            document.getElementById("profession").value = originalProfession;
            document.getElementById("profession").readOnly = true;

            document.getElementById("editBtn").style.display = "block";
            document.getElementById("saveBtn").style.display = "none";
            document.getElementById("cancelBtn").style.display = "none";
        }
    </script>

</body>
</html>
