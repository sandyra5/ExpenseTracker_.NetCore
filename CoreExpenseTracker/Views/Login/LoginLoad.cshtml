@model CoreExpenseTracker.Models.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | Expense Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f1f8f3, #fff7ed);
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 90%;
            max-width: 420px;
            padding: 35px;
            background: white;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        h2 {
            color: #198754;
            text-align: center;
            font-weight: bold;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            padding: 11px;
            border-radius: 9px;
        }

        .btn-login {
            width: 100%;
            padding: 11px;
            background: #198754;
            color: white;
            font-weight: bold;
        }

            .btn-login:hover {
                background: #146c43;
                color: white;
            }
    </style>
</head>

<body>
    <div class="login-card">
        <h2>Expense Tracker</h2>
        <p class="text-center text-secondary mb-4">
            Welcome back! Please log in.
        </p>

        <form asp-controller="Login"
              asp-action="LoginClick"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input asp-for="Username"
                       class="form-control"
                       placeholder="Enter username"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Enter password"
                       required />
            </div>

            <button type="submit" class="btn btn-login">
                Login
            </button>

            @if (ViewBag.Message != null)
            {
                <p class="text-danger text-center mt-3">
                    @ViewBag.Message
                </p>
            }
        </form>

        <p class="text-center mt-4 mb-0">
            Don't have an account?
            <a asp-controller="Register" asp-action="RegisterLoad">
                Register
            </a>
        </p>
    </div>
</body>
</html>
