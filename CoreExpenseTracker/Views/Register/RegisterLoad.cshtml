@model CoreExpenseTracker.Models.RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account | Expense Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #f1f8f3, #fff7ed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 30px 15px;
        }

        .register-card {
            width: 100%;
            max-width: 650px;
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .brand {
            color: #198754;
            font-size: 27px;
            font-weight: bold;
            text-align: center;
        }

        .subtitle {
            color: #777;
            text-align: center;
            margin-bottom: 28px;
        }

        .form-label {
            font-weight: 600;
            color: #333;
        }

        .form-control {
            padding: 11px;
            border-radius: 9px;
        }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.12);
        }

        .btn-register {
            width: 100%;
            background: #198754;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 9px;
            font-weight: bold;
            margin-top: 12px;
        }

        .btn-register:hover {
            background: #146c43;
            color: white;
        }

        .message {
            text-align: center;
            margin-top: 15px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
        }

        .login-link a {
            color: #198754;
            text-decoration: none;
            font-weight: bold;
        }

        .required {
            color: #dc3545;
        }
    </style>
</head>

<body>
    <div class="register-card">

        <div class="brand">Expense Tracker</div>
        <p class="subtitle">Create your account and take control of your money.</p>

        <form asp-controller="Register"
              asp-action="RegisterClick"
              method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control"
                           placeholder="Enter your full name" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email <span class="required">*</span></label>
                    <input asp-for="Email" type="email" class="form-control"
                           placeholder="Enter your email" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Username <span class="required">*</span></label>
                    <input asp-for="Username" class="form-control"
                           placeholder="Choose a username" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Password <span class="required">*</span></label>
                    <input asp-for="Password" type="password" class="form-control"
                           placeholder="Create a password" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Profession</label>
                    <input asp-for="Profession" class="form-control"
                           placeholder="e.g. Student, Developer" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Profile Photo <span class="required">*</span></label>
                    <input type="file"
                           name="PhotoFile"
                           class="form-control"
                           accept="image/*"
                           required />
                </div>
            </div>

            <button type="submit" class="btn btn-register">
                Create Account
            </button>

            @if (ViewBag.Message != null)
            {
                <p class="message">@ViewBag.Message</p>
            }
        </form>

        <div class="login-link">
            Already have an account?
            <a asp-controller="Login" asp-action="LoginLoad">Login</a>
        </div>

    </div>
</body>
</html>
